
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #0f172a;
    color: #f1f5f9;
    line-height: 1.7;
    transition: background 0.3s, color 0.3s;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #111c32;
    position: sticky;
    top: 0;
    gap: 15px;
}

.logo {
    color: #38bdf8;
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

.navbar a {
    color: inherit;
    text-decoration: none;
}

.navbar a:hover {
    color: #38bdf8;
}

button {
    padding: 8px 12px;
    cursor: pointer;
    border: none;
    border-radius: 8px;
}

.hero {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 50px 8%;
}

.greeting {
    color: #38bdf8;
    letter-spacing: 4px;
}

.hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 10px 0;
}

.hero h1 span {
    color: #38bdf8;
}

.hero h3 {
    margin-bottom: 15px;
}

.hero p {
    max-width: 600px;
}

.btn {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 24px;
    border-radius: 8px;
    background: #0284c7;
    color: white;
    text-decoration: none;
}

.btn:hover {
    background: #0369a1;
}

.section {
    padding: 70px 8%;
    text-align: center;
}

.section h2 {
    color: #38bdf8;
    margin-bottom: 20px;
}

.skills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
}

.skills span {
    padding: 8px 18px;
    background: #1e293b;
    border: 1px solid #38bdf8;
    border-radius: 20px;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.project-card {
    padding: 25px;
    background: #1e293b;
    border-radius: 12px;
    border: 1px solid #334155;
}

.project-card h3 {
    color: #38bdf8;
    margin-bottom: 10px;
}

footer {
    text-align: center;
    padding: 25px;
    background: #111c32;
}

/* Light mode */
body.light-mode {
    background: #f8fafc;
    color: #1e293b;
}

body.light-mode .navbar,
body.light-mode footer {
    background: #e2e8f0;
}

body.light-mode .project-card,
body.light-mode .skills span {
    background: #ffffff;
    border-color: #cbd5e1;
}

@media (max-width: 700px) {
    .navbar {
        flex-wrap: wrap;
        justify-content: center;
    }

    .navbar ul {
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: 65vh;
    }
}
