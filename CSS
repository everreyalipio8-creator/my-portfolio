
.profile-picture {
    width: 160px;
    height: 160px;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    border: 4px solid #38bdf8;
    margin-bottom: 25px;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.25);
}

@media (max-width: 600px) {
    .profile-picture {
        width: 130px;
        height: 130px;
    }
}
